
{
  "scopeName": "source.root",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.root",
          "match": "//.*$"
        },
        {
          "name": "comment.block.root",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.root",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.root",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.root",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.root",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.root",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.root",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.root",
      "match": "\\b(fn|let|mut|return|if|else|while|struct|import|pub|as)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.root",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|string|void)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.root",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "name": "constant.language.boolean.root",
      "match": "\\b(true|false)\\b"
    },
    "operators": {
      "name": "keyword.operator.root",
      "match": "==|!=|<=|>=|<<|>>|&&|\\|\\||\\+=|-=|\\*=|/=|->|[+*/%=<>!&|^~\\-]"
    }
  }
}
